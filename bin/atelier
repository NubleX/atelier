#!/usr/bin/env python3
"""Launcher: puts the project on sys.path (it may be reached through a symlink) and runs the CLI."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from atelier.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
